# Tenggat — Environment Variables
#
# BIARKAN KOSONG untuk mode lokal: data awal diambil dari src/data/tugas.js
# dan setiap perubahan disimpan di localStorage browser (bisa dipakai offline).
#
# Isi keduanya untuk beralih ke Supabase (tabel public.tugas, lihat
# supabase/schema.sql). Di Vercel, isi di Project Settings > Environment Variables.

VITE_API_BASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
